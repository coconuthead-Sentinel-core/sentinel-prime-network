<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SentinelForge.FocusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:svc="using:SentinelForge.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="TaskTemplate" x:DataType="svc:EisenhowerTask">
            <Grid ColumnSpacing="8" Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{x:Bind Done, Mode=OneWay}"
                          Checked="OnTaskChecked" Unchecked="OnTaskUnchecked" MinWidth="0" />
                <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Click="OnDeleteTask" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Delete">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Pomodoro timer ===== -->
        <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="20">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.PhaseLabel, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.TimeDisplay, Mode=OneWay}"
                           FontSize="64" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7">
                    <Run Text="Completed focus sessions:" /><Run Text=" " /><Run Text="{x:Bind ViewModel.CompletedSessions, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Command="{x:Bind ViewModel.StartPauseCommand}" Style="{StaticResource AccentButtonStyle}"
                            Content="{x:Bind ViewModel.StartPauseLabel, Mode=OneWay}" MinWidth="96" />
                    <Button Command="{x:Bind ViewModel.ResetTimerCommand}" Content="Reset" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Add task ===== -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" PlaceholderText="New task…"
                     Text="{x:Bind ViewModel.NewTaskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.NewTaskQuadrant, Mode=TwoWay}" MinWidth="150">
                <ComboBoxItem Content="Do Now" />
                <ComboBoxItem Content="Schedule" />
                <ComboBoxItem Content="Wait" />
                <ComboBoxItem Content="Done" />
            </ComboBox>
            <Button Grid.Column="2" Command="{x:Bind ViewModel.AddTaskCommand}" Style="{StaticResource AccentButtonStyle}" Content="Add" />
        </Grid>

        <!-- ===== Eisenhower matrix (2x2) ===== -->
        <Grid Grid.Row="2" RowSpacing="12" ColumnSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Q0: Do -->
            <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🟢  Do Now" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Quadrant0, Mode=OneWay}" SelectionMode="None" ItemTemplate="{StaticResource TaskTemplate}" />
                </Grid>
            </Border>

            <!-- Q1: Schedule -->
            <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="⚪  Schedule" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Quadrant1, Mode=OneWay}" SelectionMode="None" ItemTemplate="{StaticResource TaskTemplate}" />
                </Grid>
            </Border>

            <!-- Q2: Delegate -->
            <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🟡  Wait" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Quadrant2, Mode=OneWay}" SelectionMode="None" ItemTemplate="{StaticResource TaskTemplate}" />
                </Grid>
            </Border>

            <!-- Q3: Eliminate -->
            <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🔴  Done" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Quadrant3, Mode=OneWay}" SelectionMode="None" ItemTemplate="{StaticResource TaskTemplate}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
