<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SentinelForge.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SentinelForge"
    xmlns:svc="using:SentinelForge.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="PageRoot" Padding="24" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- ============ LEFT: reading ============ -->
        <Grid Grid.Column="0" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Sentinel Forge — Reader" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="{x:Bind ViewModel.EngineStatus, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
            </StackPanel>

            <!-- Commands -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.OpenDocumentCommand}" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="Open" />
                    </StackPanel>
                </Button>
                <Button Click="OnAddHighlight" ToolTipService.ToolTip="Save the selected text as a highlight">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7E6;" FontSize="14" />
                        <TextBlock Text="Highlight" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.BookmarkChapterCommand}" ToolTipService.ToolTip="Bookmark the current chapter">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A4;" FontSize="14" />
                        <TextBlock Text="Bookmark" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ReadAloudCommand}" ToolTipService.ToolTip="Read aloud">
                    <FontIcon Glyph="&#xE767;" FontSize="14" />
                </Button>
                <Button Command="{x:Bind ViewModel.StopReadingCommand}" ToolTipService.ToolTip="Stop">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                </Button>
                <TextBlock
                    Text="{x:Bind ViewModel.DocumentTitle, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>

            <!-- Chapter nav + font sizing -->
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Chapter" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.Chapters, Mode=OneWay}"
                          DisplayMemberPath="Title"
                          SelectedIndex="{x:Bind ViewModel.SelectedChapterIndex, Mode=TwoWay}" />
                <Button Grid.Column="2" Command="{x:Bind ViewModel.PreviousChapterCommand}" ToolTipService.ToolTip="Previous chapter">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <Button Grid.Column="3" Command="{x:Bind ViewModel.NextChapterCommand}" ToolTipService.ToolTip="Next chapter">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </Button>
                <Button Grid.Column="4" Command="{x:Bind ViewModel.DecreaseFontCommand}" ToolTipService.ToolTip="Smaller text">
                    <TextBlock Text="A&#x2212;" />
                </Button>
                <Button Grid.Column="5" Command="{x:Bind ViewModel.IncreaseFontCommand}" ToolTipService.ToolTip="Larger text">
                    <TextBlock Text="A+" />
                </Button>
            </Grid>

            <!-- Reading pane -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <TextBlock
                    x:Name="ReadingText"
                    Text="{x:Bind ViewModel.DocumentText, Mode=OneWay}"
                    FontSize="{x:Bind ViewModel.FontSize, Mode=OneWay}"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Grid>

        <!-- ============ RIGHT: study pane ============ -->
        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="8" Padding="8">
            <Pivot>
                <!-- Highlights -->
                <PivotItem Header="Highlights">
                    <ListView ItemsSource="{x:Bind ViewModel.Highlights, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="svc:Highlight">
                                <Grid ColumnSpacing="8" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7">
                                            <Run Text="{x:Bind Chapter}" /><Run Text=" · " /><Run Text="{x:Bind CreatedAt}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="OnDeleteHighlight" ToolTipService.ToolTip="Delete"
                                            Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>

                <!-- Notes -->
                <PivotItem Header="Notes">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" PlaceholderText="Write a note…"
                                 Text="{x:Bind ViewModel.NoteDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
                        <Button Grid.Row="1" Command="{x:Bind ViewModel.SaveNoteCommand}" Content="Save note" HorizontalAlignment="Right" />
                        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="svc:Note">
                                    <Grid ColumnSpacing="8" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind CreatedAt}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Click="OnDeleteNote" ToolTipService.ToolTip="Delete"
                                                Background="Transparent" BorderThickness="0">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </PivotItem>

                <!-- Bookmarks -->
                <PivotItem Header="Bookmarks">
                    <ListView ItemsSource="{x:Bind ViewModel.Bookmarks, Mode=OneWay}"
                              IsItemClickEnabled="True" ItemClick="OnBookmarkClick" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="svc:Bookmark">
                                <Grid ColumnSpacing="8" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind ChapterTitle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind CreatedAt}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="OnDeleteBookmark" ToolTipService.ToolTip="Delete"
                                            Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>
            </Pivot>
        </Border>
    </Grid>
</Page>
